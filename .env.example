# Copiază acest fișier ca .env.local și completează valorile.
# .env.local NU se pune pe GitHub (este în .gitignore).
# Aici sunt DOAR nume de variabile și valori demonstrative, niciodată secrete reale.

# Adresa la care rulează aplicația (Etapa 2+)
NEXT_PUBLIC_APP_URL=http://localhost:3000

